# ── AI provider ──────────────────────────────────────────────────────────────
# Which backend js-oracle uses for analysis: "anthropic" (default) or "gemini".
AI_PROVIDER=anthropic

# ── Anthropic (default provider) ─────────────────────────────────────────────
# Required when AI_PROVIDER=anthropic. Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-key-here"

# Only needed if your key is "identity-linked" and the API replies:
#   "anthropic-workspace-id is required ..."
# Put your workspace id here (Anthropic Console > Settings > Workspaces).
# ANTHROPIC_WORKSPACE_ID="wrkspc_..."

# How hard Claude deliberates per call (and how much it costs):
# low | medium | high | xhigh | max. Defaults to "medium".
ANTHROPIC_EFFORT=medium

# ── Gemini (optional alternative) ────────────────────────────────────────────
# Required only when AI_PROVIDER=gemini. Create one at https://aistudio.google.com/apikey
# Needs the optional dependency:  pip install google-genai
# GEMINI_API_KEY="your-gemini-key-here"
